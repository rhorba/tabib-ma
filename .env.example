# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/tabibma
DATABASE_USERNAME=tabibma
DATABASE_PASSWORD=changeme

# docker-compose host port overrides — only needed if the defaults (8080/5432)
# collide with another project already running on your machine.
# BACKEND_HOST_PORT=8080
# DB_HOST_PORT=5432

# Auth — RS256 per docs/security-tabib-ma.md Section 3.
# Generate a dev keypair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Then base64 the PEM contents (one line) into the vars below.
JWT_PRIVATE_KEY_B64=changeme-base64-encoded-pkcs8-private-key-pem
JWT_PUBLIC_KEY_B64=changeme-base64-encoded-x509-public-key-pem
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=2592000000

# Spring
SPRING_PROFILES_ACTIVE=dev

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Frontend — base URL (server root, no /api/v1 suffix) the React app calls for
# the backend API; the generated OpenAPI client already includes /api/v1 per path.
VITE_API_BASE_URL=http://localhost:8080

# CMI Payment Gateway
CMI_MERCHANT_ID=changeme
CMI_API_KEY=changeme
CMI_CALLBACK_URL=http://localhost:8080/api/payments/cmi/callback

# WebRTC (TURN server for video consults)
WEBRTC_TURN_URL=turn:changeme.example.com:3478
WEBRTC_TURN_USERNAME=changeme
WEBRTC_TURN_CREDENTIAL=changeme

# Email (appointment confirmations, password reset)
SMTP_HOST=changeme
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme

# SMS (appointment reminders)
SMS_PROVIDER_API_KEY=changeme

# Appointment reminders (Story 4.5) — both optional, default to 24h lead time / 15min sweep
REMINDER_LEAD_TIME_HOURS=24
REMINDER_SWEEP_INTERVAL_MS=900000

# Redis (caching, doctor availability, sessions)
REDIS_URL=redis://localhost:6379

# Object storage — local-filesystem dev/test stand-in for the real S3 adapter
# (docs/architecture-tabib-ma.md ObjectStorageClient). Path is inside the backend
# container's working directory; docker-compose mounts a named volume over it.
APP_STORAGE_LOCAL_DIR=./data/object-storage

# Video consultation join window (Story 6.1) — optional, defaults to 10 minutes each side
# of the appointment slot (matches the UX doc's join-window spec).
CONSULTATION_JOIN_WINDOW_MINUTES=10

# Seeded PLATFORM_ADMIN (V3__seed_platform_admin.sql) — dev/test bootstrap only,
# no admin-creation endpoint exists yet. Rotate or remove before production launch.
# Login: tabib-admin@tabibma.dev / changeme-admin-dev-only

# Seeded CLINIC_ADMIN (V4__clinic_invitations.sql) — same dev/test bootstrap pattern.
# Login: clinic-admin@tabibma.dev / changeme-clinicadmin-dev-only
