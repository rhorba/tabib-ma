# Base URL (server root, no path prefix) the React app calls for the backend API.
# Matches BACKEND_HOST_PORT default (8080) from the root .env.example.
# No /api/v1 suffix here — the generated OpenAPI client (src/shared/api) already
# includes /api/v1 in every path, since that's how the backend controllers are mapped.
VITE_API_BASE_URL=http://localhost:8080
